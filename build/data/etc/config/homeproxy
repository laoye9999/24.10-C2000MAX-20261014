config global 'global'
	option enabled '0'
	# rule   = 国内直连、国外走代理
	# global = 全部走代理
	# direct = 全部直连（只做 DNS 处理）
	option proxy_mode 'rule'
	option default_node ''
	option log_level 'warn'
	option tcp_fast_open '1'
	option sniff '1'
	# 用嗅探出的域名作为实际拨号目标，而不是客户端连的那个 IP。
	# 必须开着：局域网客户端的 DNS 由 dnsmasq 解析，国外域名会拿到被污染的
	# 地址，关掉的话代理会去连这个假地址，表现为"国内正常、国外全部超时"。
	option sniff_override '1'
	# 一并接管 IPv6。本机从运营商拿到的是公网 v6 前缀，客户端会优先走 v6，
	# 而 v6 一旦不被接管就等于绕过了代理——被墙的站点会直接打不开，而不是
	# 退回走已代理的 IPv4。设成 '0' 可以只代理 IPv4。
	option ipv6 '1'
	# 拦截局域网客户端发往 53 端口的查询，交给 sing-box 解析，避免用被污染的
	# 答案去连被墙的站点。
	#
	# 但本机固件用 dns_redirect=1 把所有 UDP 53 查询强制转给路由器自己的
	# dnsmasq（nat prerouting，优先级 -95，比 TPROXY 的 mangle -150 晚）。同一
	# 条查询被两处处理时，回复对不上 conntrack 记下的映射，客户端会一直等到
	# 超时。所以 firewall.sh 让路：固件接管 UDP 53 时就不碰它（DNS 由 dnsmasq
	# 回答，被污染的域名靠 sniff_override 从 TLS 握手还原真实域名），TCP 53
	# 固件不管，仍然由 sing-box 回答。
	#
	# 设成 '0' 表示连 TCP 53 也不拦截。
	option dns_hijack '1'
	# Clash API，LuCI 状态页和节点切换靠它
	option clash_api '1'
	option clash_port '9090'
	# 每个会对外拨号的 outbound（节点和 direct）的 SO_MARK。
	#
	# 必须和 TPROXY 的 mark 不同 —— 这个版本里 TPROXY 用的是 480
	# （firewall.sh 的 FWMARK），不是上游的 1。两者相同的话，firewall.sh 里
	# 那条「排除 sing-box 自己流量」的 RETURN 会匹配到它自己刚打的标，
	# 结果是静默地什么都不代理；脚本检测到这个冲突会直接关掉 self_proxy。
	option routing_mark '2'

	# 路由器自身发起的流量也走代理（不只是 LAN 转发的）。
	#
	# 默认关。打开之后，本机发起的连接 —— 订阅更新、厂商云的心跳、opkg ——
	# 都会经过节点。DNS(53/853)、NTP(123)、本机地址和保留网段始终直连：
	# sing-box 要用 223.5.5.5 解析节点域名，把解析器本身放进隧道就是自举死循环；
	# 时间跳变会让 TLS 校验失败，包括隧道那一段 TLS。
	#
	# 实现方式见 firewall.sh 里的 CHAIN_OUT/CHAIN_LO：内核的 TPROXY 目标不允许
	# 用在 OUTPUT 链，所以本机流量是在 mangle OUTPUT 打标，由策略路由送回 lo，
	# 再从 PREROUTING 的 `-i lo` 进入 TPROXY。
	option self_proxy '0'

config inbound 'inbound'
	option tproxy_port '5330'
	option lan_interface 'br-lan'
	option udp_timeout '5m'

	# 屏蔽 QUIC（UDP 443/80），让 App 回退到 TCP。默认开启。
	#
	# 节点是 vmess + ws，隧道本身就是一条 TCP，QUIC 等于「在 TCP 里面再套一层
	# 丢包恢复」：内层把外层补包造成的乱序当成丢包、自己退避，多条流之间还会
	# 队头阻塞。实测抖音在节点走 QUIC 时视频和直播播到中间会卡住、每次滑动都
	# 要等首帧；改为丢弃 UDP 443、逼它走 TCP 后症状消失。TCP 过同一条隧道只有
	# 一层拥塞控制，能自己恢复。
	#
	# 这里用 DROP 而非 REJECT 是被迫的：nftables 不允许 reject 用在
	# input/forward/output 以外的钩子，而这条链是 `type filter hook prerouting`，
	# `-j REJECT` 会以 "Invalid argument" 直接装不上。代价是客户端靠超时发现
	# 失败而不是靠 ICMP——实测浏览器和抖音都在几百毫秒内正常回退。
	#
	# 确实需要 QUIC 的场合用 `uci set homeproxy.inbound.block_quic=0` 关掉，
	# 关掉后 QUIC 会和其他 UDP 流量一样被代理。
	option block_quic '1'

# 纯界面用途的占位段：LuCI 的 SimpleSection 的 section 是 nil，放 Button /
# DummyValue 会在保存时崩溃（cbi.lua:1364 attempt to concatenate 'section'）。
# 订阅页的「全部更新」按钮和结果面板挂在这个真实存在的段上。
config actions 'actions'
	option _placeholder '1'

config dns 'dns'
	option strategy 'prefer_ipv4'
	option local_dns '223.5.5.5'
	option remote_dns 'https://1.1.1.1/dns-query'
	# 分流规则集（geoip-cn / geosite-cn / geosite-geolocation-!cn）随包附带在
	# rule_set_dir 里，sing-box 直接用本地文件，启动不依赖网络。
	#
	# 这是必须的，不是优化：sing-box 在启动阶段解析 remote 规则集，下载失败就
	# 直接退出。而 cdn.jsdelivr.net 在国内被 RST，所以只要真配了节点、又用
	# rule 模式，sing-box 永远起不来——procd 反复重试成崩溃循环，界面上看就是
	# "点了启动没反应"。
	#
	# rule_set_base 只在本地文件缺失时才作为兜底，以及给下面的刷新脚本用。
	# 默认填的是国内可达的 jsDelivr 镜像（cdn.jsdelivr.net 那个主机名被墙）。
	option rule_set_base 'https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo'
	option rule_set_interval '7d'
	option rule_set_dir '/etc/homeproxy/rule_set'
